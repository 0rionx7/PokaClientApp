{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "assets/*": ["public/assets/*"],
      "components/*": ["src/components/*"],
      "poka/*": ["src/features/poka/*"],
      "chinese/*": ["src/features/chinese/*"],
      "account/*": ["src/features/account/*"],
      "ui/*": ["src/components/ui/*"],
      "layout/*": ["src/components/layout/*"],
      "@styles/*": ["src/styles/*"],
      "styles/*": ["src/styles/*"],
      "hooks/*": ["src/hooks/*"],
      "pages/*": ["src/pages/*"],
      "store/*": ["src/store/*"],
      "utils/*": ["src/utils/*"]
    }
  },
  "include": ["src", "vitest.config.ts"]
}
